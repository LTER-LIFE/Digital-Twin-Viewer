      "aliases": ["ph"]
    },
    "turbidity": {
      "label": "Turbidity", "units": "FNU", "group": "turbidity",
      "standard_names": ["sea_water_turbidity"],
      "aliases": ["turb", "turbidity", "troebelheid"]
    },
    "benthic_diatoms_carbon": {
