{
  "_comment": [
    "Shared vocabulary for observations. Read by obs_ingest.py (Python) and by",
    "js/observations.js (browser), so the two can never disagree about what a",
    "column means or how its units convert.",
    "",
    "quantities: one entry per physical quantity. 'aliases' are matched against",
    "observation variable names AND model variable keys, case-insensitively and",
    "ignoring spaces, '-' and '_'; 'standard_names' are CF standard names. A model",
    "key ending in '-avg' is the depth-averaged form of the same quantity.",
    "",
    "units: groups of interchangeable units, each with its factor to the group's",
    "base unit (value_in_base = value * factor). 'approx' marks conversions that",
    "are only approximately exact (e.g. g/kg -> PSU) so the viewer can say so.",
    "Element tags inside a unit ('mg C/m2', 'mg Chl/m3', 'g AFDM/m2') are parsed",
    "separately: two units with different tags never convert."
  ],
  "version": 1,

  "quantities": {
    "sea_water_temperature": {
      "label": "Water temperature", "units": "degC", "group": "temperature",
      "standard_names": ["sea_water_temperature", "sea_surface_temperature", "sea_water_potential_temperature"],
      "aliases": ["temp", "t", "temperature", "watertemperature", "wt", "etw", "tw", "sst", "tempw", "twater", "temperatuur", "watertemperatuur"]
    },
    "sea_water_salinity": {
      "label": "Salinity", "units": "PSU", "group": "salinity",
      "standard_names": ["sea_water_salinity", "sea_water_practical_salinity", "sea_surface_salinity"],
      "aliases": ["salt", "sal", "salinity", "s", "psal", "practicalsalinity", "so", "saliniteit"]
    },
    "water_level": {
      "label": "Water level", "units": "m", "group": "length", "model_special": "level",
      "standard_names": ["sea_surface_height", "sea_surface_height_above_geoid", "water_surface_height_above_reference_datum", "sea_surface_elevation"],
      "aliases": ["wl", "waterlevel", "elev", "zeta", "ssh", "eta", "waterhoogte", "waterstand", "level"]
    },
    "water_depth": {
      "label": "Water depth", "units": "m", "group": "length", "model_special": "depth",
      "standard_names": ["sea_floor_depth_below_sea_surface"],
      "aliases": ["waterdepth", "totaldepth", "htot", "htotal", "waterdiepte"]
    },
    "bed_level": {
      "label": "Bed level", "units": "m", "group": "length",
      "aliases": ["bedlevel", "bedelevation", "bottomlevel", "seabedlevel", "bodemhoogte", "bodemligging", "zb"]
    },
    "current_speed": {
      "label": "Current speed", "units": "m/s", "group": "velocity",
      "standard_names": ["sea_water_speed"],
      "aliases": ["speed", "curspeed", "currentspeed", "velocity", "umag", "vel", "stroomsnelheid"]
    },
    "significant_wave_height": {
      "label": "Significant wave height", "units": "m", "group": "length",
      "standard_names": ["sea_surface_wave_significant_height"],
      "aliases": ["hm0", "hs", "swh", "hsout", "waveheight", "vhm0", "hsig", "golfhoogte"]
    },
    "wave_period_zero_crossing": {
      "label": "Wave zero-crossing period", "units": "s", "group": "time",
      "standard_names": ["sea_surface_wave_mean_period_from_variance_spectral_density_second_frequency_moment"],
      "aliases": ["tm02", "tz", "tzout", "t02", "tm2", "golfperiode"]
    },
    "wave_period_energy": {
      "label": "Wave energy period", "units": "s", "group": "time",
      "standard_names": ["sea_surface_wave_mean_period_from_variance_spectral_density_inverse_frequency_moment"],
      "aliases": ["tm10", "tme", "te", "tmm10"]
    },
    "wave_period_peak": {
      "label": "Wave peak period", "units": "s", "group": "time",
      "standard_names": ["sea_surface_wave_period_at_variance_spectral_density_maximum"],
