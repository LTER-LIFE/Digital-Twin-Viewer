      "aliases": ["bp1c", "benthicdiatoms", "microphytobenthos", "mpb"]
    },
    "epibenthos_carbon": {
      "label": "Epibenthos", "units": "mg/m2", "group": "areal_mass", "element": "c",
      "aliases": ["y1c", "epibenthos", "epibenthoscarbon", "epibenthosbiomass"]
    },
    "deposit_feeders_carbon": {
      "label": "Deposit feeders", "units": "mg/m2", "group": "areal_mass", "element": "c",
      "aliases": ["y2c", "depositfeeders", "dfbiomass", "depositfeederbiomass"]
    },
    "suspension_feeders_carbon": {
      "label": "Suspension feeders", "units": "mg/m2", "group": "areal_mass", "element": "c",
      "aliases": ["y3c", "suspensionfeeders", "sfbiomass", "suspensionfeederbiomass", "filterfeeders"]
    },
    "meiobenthos_carbon": {
      "label": "Meiobenthos", "units": "mg/m2", "group": "areal_mass", "element": "c",
