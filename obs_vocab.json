  "units": {
    "temperature": {
      "base": "degC",
      "factors": {"degc": 1, "°c": 1, "c": 1, "degreec": 1, "degreesc": 1, "celsius": 1, "degreescelsius": 1, "oc": 1},
      "offsets": {"k": -273.15, "kelvin": -273.15}
    },
    "salinity": {
      "base": "PSU",
      "factors": {"psu": 1, "pss78": 1, "pss": 1, "1e-3": 1, "0.001": 1, "1": 1},
      "approx": {"g/kg": 1, "ppt": 1, "‰": 1, "promille": 1}
    },
    "length": {
      "base": "m",
      "factors": {"m": 1, "meter": 1, "metre": 1, "meters": 1, "cm": 0.01, "mm": 0.001, "dm": 0.1, "km": 1000, "um": 1e-6, "micron": 1e-6, "micrometer": 1e-6, "nm": 1e-9}
    },
    "velocity": {
      "base": "m/s",
      "factors": {"m/s": 1, "ms-1": 1, "m.s-1": 1, "cm/s": 0.01, "cms-1": 0.01, "mm/s": 0.001, "kn": 0.514444, "knots": 0.514444, "km/h": 0.277778}
    },
    "time": {
      "base": "s",
      "factors": {"s": 1, "sec": 1, "seconds": 1, "min": 60, "h": 3600, "hr": 3600}
    },
    "angle": {
      "base": "degree",
      "factors": {"degree": 1, "degrees": 1, "deg": 1, "°": 1, "degreetrue": 1, "rad": 57.29577951308232}
    },
    "inverse_length": {
      "base": "1/m",
      "factors": {"1/m": 1, "m-1": 1, "/m": 1, "1/cm": 100}
    },
    "mass_concentration": {
      "base": "mg/m3",
      "factors": {"mg/m3": 1, "mgm-3": 1, "mg.m-3": 1, "ug/l": 1, "ugl-1": 1, "mg/l": 1000, "mgl-1": 1000, "g/m3": 1000, "gm-3": 1000, "ng/l": 0.001, "ng/ml": 1, "kg/m3": 1000000, "g/l": 1000000}
    },
    "molar_concentration": {
      "base": "mmol/m3",
      "factors": {"mmol/m3": 1, "mmolm-3": 1, "umol/l": 1, "umoll-1": 1, "um": 1, "mol/m3": 1000, "mmol/l": 1000, "nmol/l": 0.001},
      "approx": {"umol/kg": 1.025}
    },
    "areal_mass": {
      "base": "mg/m2",
      "factors": {"mg/m2": 1, "mgm-2": 1, "g/m2": 1000, "gm-2": 1000, "kg/m2": 1000000, "ug/m2": 0.001, "kg/ha": 100}
    },
    "areal_density": {
      "base": "1/m2",
      "factors": {"1/m2": 1, "m-2": 1, "n/m2": 1, "ind/m2": 1, "individuals/m2": 1, "#/m2": 1}
    },
    "fraction": {
      "base": "%",
      "factors": {"%": 1, "percent": 1, "pct": 1, "fraction": 100}
    },
    "dimensionless": {
      "base": "1",
      "factors": {"1": 1, "": 1, "-": 1, "dimensionless": 1, "nvt": 1}
    },
    "turbidity": {
      "base": "FNU",
      "factors": {"fnu": 1, "ntu": 1, "ftu": 1}
    },
    "pressure": {
      "base": "Pa",
      "factors": {"pa": 1, "n/m2": 1, "kpa": 1000, "dbar": 10000, "bar": 100000}
    },
    "kinematic_stress": {
      "base": "m2/s2",
      "factors": {"m2/s2": 1, "m2s-2": 1}
    }
  },

  "elements": ["chlorophylla", "chla", "chl", "afdm", "dw", "ww", "c", "n", "p", "si", "o2", "o"]
}
