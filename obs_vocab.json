    },
    "phosphate": {
      "label": "Phosphate", "units": "mmol/m3", "group": "molar_concentration", "element": "p",
      "standard_names": ["mole_concentration_of_phosphate_in_sea_water"],
      "aliases": ["po4", "n1p", "phosphate"]
    },
    "silicate": {
      "label": "Silicate", "units": "mmol/m3", "group": "molar_concentration", "element": "si",
