      "standard_names": ["mole_concentration_of_nitrate_in_sea_water"],
      "aliases": ["no3", "n3n", "nitrate"]
    },
    "nitrite": {
      "label": "Nitrite", "units": "mmol/m3", "group": "molar_concentration", "element": "n",
      "aliases": ["no2", "nitrite"]
    },
    "ammonium": {
      "label": "Ammonium", "units": "mmol/m3", "group": "molar_concentration", "element": "n",
